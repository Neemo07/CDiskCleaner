<Window x:Class="CDiskCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="C: Disk Cleaner"
        Icon="/Assets/app-icon.ico"
        Height="810"
        Width="1440"
        MinHeight="620"
        MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackground}"
        FontFamily="{StaticResource AppFont}"
        FlowDirection="RightToLeft"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Closing="MainWindow_OnClosing"
        Closed="MainWindow_OnClosed">

    <Grid Background="{StaticResource BrushBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="44"
                        Height="44"
                        CornerRadius="11"
                        Background="{StaticResource BrushAccent}"
                        VerticalAlignment="Center">
                    <TextBlock Text="C:"
                               Foreground="White"
                               FontSize="17"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource App.Title}" Style="{StaticResource HeadingText}" />
                    <TextBlock Text="{DynamicResource App.Subtitle}"
                               Style="{StaticResource MutedText}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <Border Grid.Column="4" Style="{StaticResource SoftPanel}" Padding="14,8" MinWidth="225">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Header.FreeSpace}" Style="{StaticResource CaptionText}" />
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <TextBlock Text="{Binding FreeSpaceText}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="{Binding FreeOfText}"
                                       Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Bottom"
                                       Margin="6,0,6,2" />
                        </StackPanel>
                        <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}"
                                     Maximum="100"
                                     Height="4"
                                     Margin="0,5,0,0"
                                     ToolTip="{Binding UsedSpaceText}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{DynamicResource Header.Report}"
                            x:Name="ReportButton"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ShowReportCommand}" />
                    <Button Content="{Binding LanguageButtonText}"
                            x:Name="LanguageButton"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ToggleLanguageCommand}"
                            Margin="8,0,8,0"
                            MinWidth="74" />
                    <Border Background="{StaticResource BrushSurfaceAlt}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="9,7"
                            VerticalAlignment="Center"
                            ToolTip="{DynamicResource Header.NotElevated}">
                        <TextBlock Text="{Binding AdminStatusText}"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </Border>
                    <Button Content="{DynamicResource Header.Elevate}"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding ElevateCommand}"
                            Margin="6,0,0,0"
                            Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="20,16,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="248" />
                <ColumnDefinition x:Name="GapColumn1" Width="14" />
                <ColumnDefinition x:Name="ListColumn" Width="*" />
                <ColumnDefinition x:Name="GapColumn2" Width="14" />
                <ColumnDefinition x:Name="DetailsColumn" Width="344" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Button Content="{DynamicResource Sidebar.ScanStart}"
                                    x:Name="StartScanButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding StartScanCommand}"
                                    Padding="14,11"
                                    Visibility="{Binding IsScanning, Converter={StaticResource InverseBoolToVisibility}}" />
                            <Button Content="{DynamicResource Sidebar.ScanCancel}"
                                    x:Name="CancelScanButton"
                                    Style="{StaticResource DangerButton}"
                                    Command="{Binding CancelScanCommand}"
                                    Padding="14,11"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <Border Style="{StaticResource SoftPanel}"
                                Background="{StaticResource BrushSuccessSoft}"
                                BorderBrush="#A7F3D0"
                                Padding="9"
                                Margin="0,9,0,0">
                            <TextBlock Text="{DynamicResource Sidebar.AutoDeleteNote}"
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource BrushSuccess}" />
                        </Border>

                        <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,10,0,8" />

                        <TextBlock Text="{DynamicResource Sidebar.ScanOptions}" Style="{StaticResource SubheadingText}" />
                        <CheckBox IsChecked="{Binding FullScan, Mode=TwoWay}"
                                  x:Name="FullScanCheck"
                                  IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolean}}"
                                  HorizontalContentAlignment="Stretch"
                                  Margin="0,9,0,0">
                            <TextBlock Text="{DynamicResource Sidebar.OptionsFullScan}" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox IsChecked="{Binding FindDuplicates, Mode=TwoWay}"
                                  x:Name="FindDuplicatesCheck"
                                  IsEnabled="{Binding FullScan}"
                                  HorizontalContentAlignment="Stretch"
                                  Margin="0,6,0,0"
                                  ToolTip="{DynamicResource Sidebar.OptionsDuplicates}">
                            <TextBlock Text="{DynamicResource Sidebar.OptionsDuplicates}" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Text="{Binding ScanHintText}"
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,6,0,0"
                                   Visibility="Collapsed" />

                        <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,10,0,8" />

                        <TextBlock Text="{DynamicResource Sidebar.Categories}" Style="{StaticResource SubheadingText}" />
                        <ListBox ItemsSource="{Binding CategoryOptions}"
                                 SelectedItem="{Binding SelectedCategoryOption, Mode=TwoWay}"
                                 Style="{StaticResource CategoryListBox}"
                                 ItemContainerStyle="{StaticResource CategoryListItem}"
                                 Margin="0,10,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26"
                                                Height="26"
                                                CornerRadius="7"
                                                Background="{Binding Category, Converter={StaticResource CategoryToBrush}}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Letter}"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Title}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CountText}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" />
                                            <TextBlock Text=" • " FontSize="10" Foreground="{StaticResource BrushTextMuted}" />
                                            <TextBlock Text="{Binding SizeText}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Candidate list -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,13,16,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource List.Title}" Style="{StaticResource SubheadingText}" />
                            <TextBlock Text="{Binding PendingSummaryText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                        </StackPanel>

                        <Grid Grid.Column="1" Width="230" VerticalAlignment="Center">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBox}"
                                     ToolTip="{DynamicResource List.SearchPlaceholder}" />
                            <TextBlock Text="{DynamicResource List.SearchPlaceholder}"
                                       Style="{StaticResource MutedText}"
                                       Margin="11,0,11,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       Visibility="{Binding SearchText, Converter={StaticResource EmptyStringToVisibility}}" />
                        </Grid>

                        <CheckBox Grid.Column="3"
                                  Content="{DynamicResource List.HideSkipped}"
                                  IsChecked="{Binding HideSkipped, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <Border Grid.Row="1" Height="1" Background="{StaticResource BrushBorder}" />

                    <Grid Grid.Row="2">
                        <DataGrid x:Name="ResultsGrid"
                                  ItemsSource="{Binding ItemsView}"
                                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                  Style="{StaticResource ResultsGrid}"
                                  MouseDoubleClick="ResultsGrid_OnMouseDoubleClick"
                                  Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="SelectColumn"
                                                        Width="44"
                                                        CanUserSort="False"
                                                        CanUserResize="False">
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding DataContext.SelectAllVisible, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                                      AutomationProperties.AutomationId="SelectAllCheck"
                                                      ToolTip="{DynamicResource List.SelectAll}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanBeDeleted}"
                                                      AutomationProperties.AutomationId="SelectionCheck"
                                                      Checked="SelectionCheck_OnToggle"
                                                      Unchecked="SelectionCheck_OnToggle"
                                                      ToolTip="{DynamicResource Column.Select}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="ItemColumn" Header="Item" Width="*" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30"
                                                        Height="30"
                                                        CornerRadius="7"
                                                        Background="{StaticResource BrushSurfaceAlt}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Kind, Converter={StaticResource KindGlyph}}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13"
                                                               Foreground="{StaticResource BrushTextSecondary}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Path}"
                                                               FontSize="10.5"
                                                               Foreground="{StaticResource BrushTextMuted}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="SizeColumn" Header="Size" Width="82" SortMemberPath="SizeBytes">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SizeText}"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="CategoryColumn" Header="Category" Width="66" SortMemberPath="Category">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Category, Converter={StaticResource CategoryToBrush}}"
                                                    CornerRadius="5"
                                                    Padding="7,3"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}"
                                                           Foreground="White"
                                                           FontSize="11"
                                                           FontWeight="Bold" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="SafetyColumn" Header="Safety" Width="105" SortMemberPath="Safety">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SafetyText}"
                                                       FontSize="11.5"
                                                       Foreground="{Binding Safety, Converter={StaticResource CategoryToBrush}}"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="ModifiedColumn" Header="Last modified" Width="118" SortMemberPath="LastModified">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LastModifiedText}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="StatusColumn" Header="Status" Width="96" SortMemberPath="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Welcome -->
                        <Border Background="{StaticResource BrushSurface}"
                                Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                                <Border Width="58" Height="58" CornerRadius="15" Background="{StaticResource BrushAccentSoft}" HorizontalAlignment="Center">
                                    <TextBlock Text="C:"
                                               FontSize="21"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrushAccent}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{DynamicResource List.WelcomeTitle}"
                                           Style="{StaticResource HeadingText}"
                                           TextAlignment="Center"
                                           Margin="0,16,0,0" />
                                <TextBlock Text="{DynamicResource List.WelcomeBody}"
                                           Style="{StaticResource MutedText}"
                                           TextAlignment="Center"
                                           Margin="0,8,0,0" />
                                <TextBlock Text="{DynamicResource List.WelcomeNote}"
                                           Style="{StaticResource CaptionText}"
                                           TextAlignment="Center"
                                           Margin="0,10,0,0" />
                                <Border Background="{StaticResource BrushAccentSoft}"
                                        CornerRadius="8"
                                        Padding="12,8"
                                        HorizontalAlignment="Center"
                                        Margin="0,18,0,0">
                                    <TextBlock Text="{DynamicResource List.WelcomeAction}"
                                               Style="{StaticResource CaptionText}"
                                               Foreground="{StaticResource BrushAccent}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Scanning -->
                        <Border Background="{StaticResource BrushSurface}"
                                Visibility="{Binding ShowScanning, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                                <TextBlock Text="{DynamicResource Sidebar.Scanning}"
                                           Style="{StaticResource HeadingText}"
                                           TextAlignment="Center" />
                                <TextBlock Text="{Binding PhaseText}"
                                           Style="{StaticResource MutedText}"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0" />
                                <TextBlock Text="{Binding ScanHintText}"
                                           Style="{StaticResource CaptionText}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding ScanHintText, Converter={StaticResource EmptyStringToVisibility}, ConverterParameter=invert}" />
                                <ProgressBar IsIndeterminate="True" Margin="0,18,0,0" />
                                <TextBlock Text="{Binding CurrentPath}"
                                           Style="{StaticResource CaptionText}"
                                           TextTrimming="CharacterEllipsis"
                                           TextAlignment="Center"
                                           Margin="0,12,0,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding FilesScanned, StringFormat={}{0:N0}}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{DynamicResource Footer.Files}" Style="{StaticResource CaptionText}" Margin="5,0,14,0" />
                                    <TextBlock Text="{Binding DirectoriesScanned, StringFormat={}{0:N0}}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{DynamicResource Footer.Folders}" Style="{StaticResource CaptionText}" Margin="5,0,14,0" />
                                    <TextBlock Text="{Binding LiveCandidateCount, StringFormat={}{0:N0}}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{DynamicResource Footer.Candidates}" Style="{StaticResource CaptionText}" Margin="5,0,0,0" />
                                </StackPanel>
                                <Button Content="{DynamicResource Sidebar.ScanCancel}"
                                        Style="{StaticResource DangerButton}"
                                        Command="{Binding CancelScanCommand}"
                                        HorizontalAlignment="Center"
                                        Margin="0,18,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Empty filtered list -->
                        <Border Background="{StaticResource BrushSurface}"
                                Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{DynamicResource List.Empty}"
                                       Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- Selection actions: only visible while something is ticked -->
                    <Border Grid.Row="3"
                            Background="{StaticResource BrushSurfaceAlt}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="0,1,0,0"
                            Padding="16,9"
                            Visibility="{Binding HasSelectedItems, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectedSummaryText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="DeleteSelectedButton"
                                        Content="{DynamicResource List.DeleteSelected}"
                                        Style="{StaticResource DangerOutlineButton}"
                                        Command="{Binding DeleteSelectedCommand}"
                                        Padding="12,7" />
                                <Button x:Name="ClearSelectionButton"
                                        Content="{DynamicResource List.ClearSelection}"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding ClearSelectionCommand}"
                                        Padding="10,7"
                                        Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Details -->
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="16,13">
                        <TextBlock Text="{DynamicResource Details.Title}" Style="{StaticResource SubheadingText}" />
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="16,14">
                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SelectedItem.Name}"
                                       Style="{StaticResource HeadingText}"
                                       TextWrapping="Wrap"
                                       TextTrimming="None" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SelectedItem.Path, Mode=OneWay}"
                                         Style="{StaticResource ReadOnlyTextBox}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="False"
                                         VerticalContentAlignment="Top"
                                         MinHeight="34"
                                         ToolTip="{Binding SelectedItem.Path}" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource IconButton}"
                                        Content="&#xE8C8;"
                                        FontFamily="Segoe MDL2 Assets"
                                        Command="{Binding CopyPathCommand}"
                                        ToolTip="{DynamicResource Details.CopyPath}"
                                        Margin="4,0,4,0" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Border Background="{Binding SelectedItem.Category, Converter={StaticResource CategoryToBrush}}"
                                        CornerRadius="5"
                                        Padding="8,3"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedItem.Category}"
                                               Foreground="White"
                                               FontSize="11"
                                               FontWeight="Bold" />
                                </Border>
                                <TextBlock Text="{Binding SelectedItem.SafetyText}"
                                           FontSize="11.5"
                                           Foreground="{Binding SelectedItem.Safety, Converter={StaticResource CategoryToBrush}}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,8,0" />
                                <Border Background="{StaticResource BrushSurfaceAlt}"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="7,3"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedItem.StatusText}" Style="{StaticResource CaptionText}" />
                                </Border>
                            </StackPanel>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Details.Size}" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding SelectedItem.SizeText}" Style="{StaticResource FieldValue}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Details.FileCount}" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding SelectedItem.FileCountText}" Style="{StaticResource FieldValue}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                                    <TextBlock Text="{DynamicResource Details.Type}" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding SelectedItem.TypeText}" Style="{StaticResource FieldValue}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                    <TextBlock Text="{DynamicResource Details.Modified}" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding SelectedItem.LastModifiedText}" Style="{StaticResource FieldValue}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0">
                                    <TextBlock Text="{DynamicResource Details.Recommend}" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding SelectedItem.RecommendText}" Style="{StaticResource FieldValue}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                                    <TextBlock Text="{DynamicResource Details.AdminLabel}" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding SelectedItem.AdminText}" Style="{StaticResource FieldValue}" />
                                </StackPanel>
                            </Grid>

                            <Border Background="{StaticResource BrushSurfaceAlt}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="11"
                                    Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Details.Reason}" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding SelectedItem.Reason}" Style="{StaticResource BodyText}" />
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="{DynamicResource Details.Recover}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding SelectedItem.RecoverabilityText}" Style="{StaticResource MutedText}" />
                            </StackPanel>

                            <Border Background="{StaticResource BrushWarningSoft}"
                                    BorderBrush="#FDE68A"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="10"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding ShowFolderNote, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{DynamicResource Details.FolderContents}"
                                           Style="{StaticResource CaptionText}"
                                           Foreground="{StaticResource BrushWarning}" />
                            </Border>

                            <Border Background="{StaticResource BrushWarningSoft}"
                                    BorderBrush="#FDE68A"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="10"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding ShowGroupNote, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding GroupContentsText}"
                                           Style="{StaticResource CaptionText}"
                                           Foreground="{StaticResource BrushWarning}" />
                            </Border>

                            <Border Background="{StaticResource BrushWarningSoft}"
                                    BorderBrush="#FDE68A"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="10"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding ShowAdminNote, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{DynamicResource Details.AdminHint}"
                                           Style="{StaticResource CaptionText}"
                                           Foreground="{StaticResource BrushWarning}" />
                            </Border>

                            <Border Background="{StaticResource BrushDangerSoft}"
                                    BorderBrush="#FECACA"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="10"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding ShowProtectedNote, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Details.Protected}"
                                               Style="{StaticResource CaptionText}"
                                               Foreground="{StaticResource BrushDanger}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource Details.ProtectedHint}"
                                               Style="{StaticResource CaptionText}"
                                               Foreground="{StaticResource BrushDanger}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource BrushDangerSoft}"
                                    BorderBrush="#FECACA"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="10"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding ShowFailureDetail, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Details.FailureDetail}"
                                               Style="{StaticResource FieldLabel}"
                                               Foreground="{StaticResource BrushDanger}" />
                                    <TextBlock Text="{Binding SelectedItem.StatusDetail}"
                                               Style="{StaticResource CaptionText}"
                                               Foreground="{StaticResource BrushDanger}" />
                                </StackPanel>
                            </Border>

                            <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,16,0,14" />

                            <TextBlock Text="{DynamicResource Details.Actions}" Style="{StaticResource SubheadingText}" />
                            <StackPanel Margin="0,10,0,0">
                                <Button Content="{DynamicResource Details.Recycle}"
                                        x:Name="RecycleButton"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding DeleteRecycleCommand}"
                                        HorizontalContentAlignment="Center"
                                        Padding="14,10" />
                                <TextBlock Text="{DynamicResource Details.RecycleHint}"
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,5,0,0" />
                                <Button Content="{DynamicResource Details.Permanent}"
                                        Style="{StaticResource DangerOutlineButton}"
                                        Command="{Binding DeletePermanentCommand}"
                                        HorizontalContentAlignment="Center"
                                        Padding="14,10"
                                        Margin="0,12,0,0" />
                                <TextBlock Text="{DynamicResource Details.PermanentHint}"
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,5,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            x:Name="SkipButton"
                                            Content="{DynamicResource Details.Skip}"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding SkipCommand}"
                                            Padding="12,9" />
                                    <Button Grid.Column="2"
                                            Content="{DynamicResource Details.OpenLocation}"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding OpenLocationCommand}"
                                            Padding="12,9" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Grid.Row="1"
                               Text="{DynamicResource Details.NoSelection}"
                               Style="{StaticResource MutedText}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="34"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0">
            <Grid Margin="20,9,20,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="380"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding CurrentPath}"
                               Style="{StaticResource CaptionText}"
                               TextTrimming="CharacterEllipsis"
                               Margin="10,0,12,0"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PhaseOrReadyText}"
                                   Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <ProgressBar IsIndeterminate="{Binding IsScanning}" Width="190" Height="6" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,7,0,0">
                    <TextBlock Text="{Binding ConfigWarningText}"
                               Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource BrushWarning}"
                               Margin="0,0,16,0"
                               Visibility="{Binding ShowConfigWarning, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="{Binding FilesScanned, StringFormat={}{0:N0}}" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Footer.Files}" Style="{StaticResource CaptionText}" Margin="5,0,5,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="{Binding DirectoriesScanned, StringFormat={}{0:N0}}" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Footer.Folders}" Style="{StaticResource CaptionText}" Margin="5,0,5,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="{Binding LiveCandidateCount, StringFormat={}{0:N0}}" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Footer.Candidates}" Style="{StaticResource CaptionText}" Margin="5,0,5,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="{Binding RecoveredText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}" />
                        <TextBlock Text="{DynamicResource Footer.Recovered}" Style="{StaticResource CaptionText}" Margin="5,0,5,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="{Binding SessionRecycledCount, StringFormat={}{0:N0}}" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Footer.Recycled}" Style="{StaticResource CaptionText}" Margin="5,0,5,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="{Binding SessionSkippedCount, StringFormat={}{0:N0}}" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Footer.Skipped}" Style="{StaticResource CaptionText}" Margin="5,0,5,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="{Binding SessionFailedCount, StringFormat={}{0:N0}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushDanger}" />
                        <TextBlock Text="{DynamicResource Footer.Failed}" Style="{StaticResource CaptionText}" Margin="5,0,5,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0"
                                Visibility="{Binding InaccessibleDirectories, Converter={StaticResource PositiveIntToVisibility}}">
                        <TextBlock Text="{Binding InaccessibleDirectories, StringFormat={}{0:N0}}" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Footer.Inaccessible}" Style="{StaticResource CaptionText}" Margin="5,0,5,0" />
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
