<Window x:Class="CDiskCleaner.Views.ConfirmDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm operation"
        Icon="/Assets/app-icon.ico"
        Width="570"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BrushBackground}"
        FontFamily="{StaticResource AppFont}"
        FlowDirection="RightToLeft">
    <Border Style="{StaticResource Card}" Margin="14" Padding="20">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="MethodBadge"
                        Width="42"
                        Height="42"
                        CornerRadius="10"
                        Background="{StaticResource BrushAccent}"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="MethodGlyph"
                               Text="↺"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText" Style="{StaticResource HeadingText}" />
                    <TextBlock x:Name="MessageText" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource SoftPanel}" Padding="12" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock x:Name="ItemName"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBox x:Name="PathBox"
                             Style="{StaticResource ReadOnlyTextBox}"
                             TextWrapping="Wrap"
                             AcceptsReturn="False"
                             VerticalContentAlignment="Top"
                             MinHeight="34"
                             Margin="0,8,0,0" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="SizeLabel" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="SizeText" Style="{StaticResource FieldValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="TypeLabel" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="TypeText" Style="{StaticResource FieldValue}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="FolderNotePanel"
                    Background="{StaticResource BrushWarningSoft}"
                    BorderBrush="#FDE68A"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="10"
                    Margin="0,12,0,0"
                    Visibility="Collapsed">
                <TextBlock x:Name="FolderNoteText"
                           Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource BrushWarning}" />
            </Border>

            <Border x:Name="PermanentWarningPanel"
                    Background="{StaticResource BrushDangerSoft}"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="10"
                    Margin="0,12,0,0"
                    Visibility="Collapsed">
                <TextBlock Text="{DynamicResource Confirm.PermanentWarning}"
                           Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource BrushDanger}"
                           FontWeight="SemiBold" />
            </Border>

            <Border x:Name="AdminWarningPanel"
                    Background="{StaticResource BrushWarningSoft}"
                    BorderBrush="#FDE68A"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="10"
                    Margin="0,12,0,0"
                    Visibility="Collapsed">
                <TextBlock Text="{DynamicResource Confirm.AdminWarning}"
                           Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource BrushWarning}" />
            </Border>

            <Border x:Name="CapacityWarningPanel"
                    Background="{StaticResource BrushWarningSoft}"
                    BorderBrush="#FDE68A"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="10"
                    Margin="0,12,0,0"
                    Visibility="Collapsed">
                <TextBlock x:Name="CapacityWarningText"
                           Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource BrushWarning}" />
            </Border>

            <CheckBox x:Name="AcknowledgeCheck"
                      Margin="0,14,0,0"
                      Visibility="Collapsed"
                      Checked="AcknowledgeCheck_OnChecked"
                      Unchecked="AcknowledgeCheck_OnChecked" />

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1"
                        x:Name="CancelButton"
                        Style="{StaticResource SecondaryButton}"
                        IsCancel="True"
                        Click="CancelButton_OnClick"
                        Padding="20,9" />
                <Button Grid.Column="3"
                        x:Name="ConfirmButton"
                        Style="{StaticResource PrimaryButton}"
                        Click="ConfirmButton_OnClick"
                        Padding="20,9" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
