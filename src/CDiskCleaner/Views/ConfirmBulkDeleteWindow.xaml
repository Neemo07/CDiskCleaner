<Window x:Class="CDiskCleaner.Views.ConfirmBulkDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm operation"
        Icon="/Assets/app-icon.ico"
        Width="640"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BrushBackground}"
        FontFamily="{StaticResource AppFont}"
        FlowDirection="RightToLeft">
    <Border Style="{StaticResource Card}" Margin="14" Padding="20">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="42"
                        Height="42"
                        CornerRadius="10"
                        Background="{StaticResource BrushDanger}"
                        VerticalAlignment="Center">
                    <TextBlock Text="!"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText" Style="{StaticResource HeadingText}" />
                    <TextBlock x:Name="MessageText"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="CountLabel" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="CountText" Style="{StaticResource FieldValue}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="SizeLabel" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="SizeText" Style="{StaticResource FieldValue}" />
                </StackPanel>
            </Grid>

            <Border BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,12,0,0"
                    Height="196">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Path}"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SizeText}"
                                               FontSize="11.5"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Background="{StaticResource BrushDangerSoft}"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="10"
                    Margin="0,12,0,0">
                <TextBlock Text="{DynamicResource Confirm.BulkPermanentHint}"
                           Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource BrushDanger}"
                           TextWrapping="Wrap" />
            </Border>

            <Border x:Name="AdminWarningPanel"
                    Background="{StaticResource BrushWarningSoft}"
                    BorderBrush="#FDE68A"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="10"
                    Margin="0,10,0,0"
                    Visibility="Collapsed">
                <TextBlock Text="{DynamicResource Confirm.AdminWarning}"
                           Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource BrushWarning}" />
            </Border>

            <CheckBox x:Name="AcknowledgeCheck"
                      Margin="0,14,0,0"
                      Content="{DynamicResource Confirm.BulkAcknowledge}"
                      Checked="AcknowledgeCheck_OnChecked"
                      Unchecked="AcknowledgeCheck_OnChecked" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1"
                        x:Name="CancelButton"
                        Style="{StaticResource SecondaryButton}"
                        IsCancel="True"
                        Click="CancelButton_OnClick"
                        Padding="18,9" />
                <Button Grid.Column="3"
                        x:Name="RecycleButton"
                        Style="{StaticResource PrimaryButton}"
                        Click="RecycleButton_OnClick"
                        Padding="18,9" />
                <Button Grid.Column="5"
                        x:Name="PermanentButton"
                        Style="{StaticResource DangerButton}"
                        IsEnabled="False"
                        Click="PermanentButton_OnClick"
                        Padding="18,9" />
            </Grid>
        </StackPanel>
    </Border>
</Window>