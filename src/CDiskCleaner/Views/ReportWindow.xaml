<Window x:Class="CDiskCleaner.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session report"
        Icon="/Assets/app-icon.ico"
        Width="780"
        Height="680"
        MinWidth="660"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BrushBackground}"
        FontFamily="{StaticResource AppFont}"
        FlowDirection="RightToLeft">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,14">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource HeadingText}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,12,0,0">
            <Border Style="{StaticResource SoftPanel}" Padding="12,9" Margin="0,0,5,5">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Report.Before}" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding Before}" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SoftPanel}" Padding="12,9" Margin="5,0,5,5">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Report.Now}" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding Now}" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SoftPanel}" Padding="12,9" Margin="5,0,5,5">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Report.Net}" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding Net}" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SoftPanel}" Padding="12,9" Margin="5,0,0,5">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Report.Recovered}" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding Recovered}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel>
                        <TextBlock Text="{DynamicResource Report.DeletedCount}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding DeletedCount}" FontWeight="SemiBold" FontSize="12" Margin="5,0,14,0" />
                        <TextBlock Text="{DynamicResource Report.RecycledCount}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding RecycledCount}" FontWeight="SemiBold" FontSize="12" Margin="5,0,14,0" />
                        <TextBlock Text="{DynamicResource Report.SkippedCount}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding SkippedCount}" FontWeight="SemiBold" FontSize="12" Margin="5,0,14,0" />
                        <TextBlock Text="{DynamicResource Report.FailedCount}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding FailedCount}" FontWeight="SemiBold" FontSize="12" Margin="5,0,14,0" />
                        <TextBlock Text="{DynamicResource Report.RemainingCount}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding RemainingCount}" FontWeight="SemiBold" FontSize="12" Margin="5,0,0,0" />
                    </WrapPanel>
                    <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource CaptionText}" Foreground="{StaticResource BrushSuccess}" />
                </Grid>

                <Border Grid.Row="1" Height="1" Background="{StaticResource BrushBorder}" Margin="0,10,0,10" />

                <TextBox Grid.Row="2"
                         Text="{Binding Text, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         FontFamily="{StaticResource AppFont}"
                         FontSize="12"
                         Background="{StaticResource BrushSurfaceAlt}"
                         BorderBrush="{StaticResource BrushBorder}"
                         BorderThickness="1"
                         Padding="12"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button Content="{DynamicResource Report.Copy}" Style="{StaticResource SecondaryButton}" Click="CopyButton_OnClick" />
            <Button Content="{DynamicResource Report.Save}" Style="{StaticResource SecondaryButton}" Click="SaveButton_OnClick" Margin="8,0,8,0" />
            <Button Content="{DynamicResource Report.Close}" Style="{StaticResource PrimaryButton}" Click="CloseButton_OnClick" MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>
