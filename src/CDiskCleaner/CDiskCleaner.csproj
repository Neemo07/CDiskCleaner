<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>CDiskCleaner</RootNamespace>
    <AssemblyName>CDiskCleaner</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>C: Disk Cleaner</AssemblyTitle>
    <Product>C: Disk Cleaner</Product>
    <Company>CDiskCleaner</Company>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <NeutralLanguage>ar</NeutralLanguage>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- same icon for the window/title bar, generated by tools\make-icon.ps1 -->
    <Resource Include="Assets\app-icon.ico" />
  </ItemGroup>
</Project>
